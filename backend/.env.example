# Servidor
PORT=3000
NODE_ENV=development

# Base de datos local de docker-compose
# Debe coincidir con POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB y POSTGRES_HOST_PORT del .env de la raíz
DATABASE_URL=postgres://tu_usuario:tu_password@localhost:5433/tu_base_de_datos

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Autenticación JWT
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d

# MercadoPago (credenciales de prueba / sandbox)
MP_ACCESS_TOKEN=tu_access_token_de_prueba
MP_PUBLIC_KEY=tu_public_key_de_prueba

# URL pública del backend para webhooks (ngrok en desarrollo)
BACKEND_PUBLIC_URL=https://tu-subdominio.ngrok-free.app
