# Copiar a .env.test y completar con valores locales de test.
# El nombre de la base debe terminar en _test.
PORT=<puerto-local>
NODE_ENV=test
DATABASE_URL=postgresql://<usuario>:<clave>@<host>:<puerto>/subi_test
FRONTEND_URL=<url-del-frontend-local>
JWT_SECRET=<secreto-de-test-de-al-menos-32-caracteres>
JWT_EXPIRES_IN=<duracion-del-token>
